# =====================================================================
# Indian Constitution Legal AI Assistant - Environment Configuration
# =====================================================================

# LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.0

# Embedding Model Configuration
# Available options:
# - sentence-transformers/all-MiniLM-L6-v2 (384-d, fast baseline)
# - BAAI/bge-m3 (1024-d, multilingual/legal state-of-the-art)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
DEVICE=cpu

# Vector Store (ChromaDB) Configuration
CHROMA_PERSIST_DIR=data/chroma_db
# Collection name dynamically routes based on embedding model if left default
CHROMA_COLLECTION_NAME=indian_legal_rag

# Retrieval Pipeline Parameters
TOP_K_DENSE=15
TOP_K_BM25=15
RRF_K=60
TOP_K_RERANK=5
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Abstention & Grounding Thresholds
SIMILARITY_THRESHOLD=0.35
CITATION_THRESHOLD=0.70
ABSTENTION_THRESHOLD=0.40

# Logging & Telemetry
LOG_LEVEL=INFO


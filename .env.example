# =====================================================================
# Indian Constitution Legal AI Assistant - Environment Configuration
# =====================================================================

# Google Gemini API Key
# Optional: If omitted, the application operates 100% offline using
# the built-in deterministic HeuristicLegalSynthesizer.
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Model Configuration (Default: gemini-3.8-flash)
# Options: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-3.8-flash

# Embedding Model Configuration
# Options:
# - BAAI/bge-m3 (1024-d, multilingual/legal state-of-the-art, default)
# - sentence-transformers/all-MiniLM-L6-v2 (384-d, lightweight CPU baseline)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# Vector Store (ChromaDB) Persistence Directory
# Defaults to repository root / chroma_db
CHROMA_PERSIST_DIR=chroma_db

# ChromaDB Collection Routing:
# Automatically routes based on embedding model:
# - BAAI/bge-m3 -> indian_legal_rag_bgem3
# - all-MiniLM-L6-v2 -> indian_legal_rag
# CHROMA_COLLECTION_NAME=indian_legal_rag_bgem3

# Logging & Verification Levels
LOG_LEVEL=INFO
